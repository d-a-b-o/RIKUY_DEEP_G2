# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local al repositorio. En Vercel, estas variables se configuran
# por entorno (Production / Preview / Development): ver docs/despliegue.md.

# ─── Base de datos (Neon) ───────────────────────────────────────────────────
# Conexión con pooler (host con "-pooler"): la usa la aplicación.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/rikuydeep?sslmode=require"
# Conexión directa (sin "-pooler"): la usan las migraciones de Prisma.
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/rikuydeep?sslmode=require"

# ─── Sitio ──────────────────────────────────────────────────────────────────
# URL pública para metadatos, sitemap y Open Graph. En Vercel se deduce sola.
# NEXT_PUBLIC_SITE_URL="https://rikuydeep.example"

# ─── Correo (Resend), aviso de solicitudes de demo ──────────────────────────
# Sin RESEND_API_KEY los leads se guardan igual, pero no se envía el aviso.
RESEND_API_KEY=""
# Destinatarios del aviso, separados por comas.
LEAD_NOTIFICATION_TO="ventas@rikuydeep.example"
# Remitente verificado en Resend. Sin dominio propio, usa el de pruebas de Resend.
LEAD_NOTIFICATION_FROM="RikuyDeep <onboarding@resend.dev>"
